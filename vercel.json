{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "cd frontend && yarn install",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "SKIP_PRERENDER": "1"
    }
  },
  "redirects": [{ "source": "/nursing", "destination": "/nursing/", "permanent": true }],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/main-sitemap.xml", "destination": "/api" },
    { "source": "/blog-sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
